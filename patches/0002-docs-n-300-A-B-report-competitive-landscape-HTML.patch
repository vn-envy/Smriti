+
+  header{
+    position:relative;
+    padding:64px 0 48px;
+    border-bottom:1px solid var(--line);
+    background:
+      radial-gradient(900px 420px at 78% -8%, rgba(244,164,60,.10), transparent 60%),
+      radial-gradient(700px 400px at 8% 120%, rgba(82,199,190,.07), transparent 60%);
+  }
+  .brand{display:flex;align-items:baseline;gap:14px;margin-bottom:44px}
+  .brand .logo{font-family:'Space Grotesk';font-weight:700;font-size:22px;letter-spacing:-.01em}
+  .brand .deva{font-size:20px;color:var(--amber);font-weight:500}
+  .brand .tag{margin-left:auto;font-family:'JetBrains Mono';font-size:11px;color:var(--mute);
+    border:1px solid var(--line);border-radius:999px;padding:5px 12px;letter-spacing:.12em}
+  h1{font-size:clamp(34px,5.2vw,56px)}
+  h1 .obs{color:var(--amber);position:relative;white-space:nowrap}
+  h1 .obs::after{
+    content:"";position:absolute;left:0;right:0;bottom:.08em;height:3px;
+    background:linear-gradient(90deg,var(--amber),transparent);border-radius:2px;
+  }
+  .lede{margin-top:18px;font-size:17px;color:var(--mute);max-width:46ch}
+  .lede b{color:var(--paper);font-weight:600}
+  .facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
+  .chip{
+    font-family:'JetBrains Mono';font-size:12px;color:var(--paper);
+    border:1px solid var(--line2);border-radius:999px;padding:7px 13px;background:rgba(255,255,255,.015)
+  }
+  .chip b{color:var(--amber);font-weight:500}
+
+  section{padding:54px 0;border-bottom:1px solid var(--line)}
+  .sec-head{margin-bottom:32px}
+  .sec-head h2{font-size:clamp(26px,3.2vw,34px)}
+  .sec-head p{color:var(--mute);margin-top:12px;max-width:62ch}
+
+  /* stat cards */
+  .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
+  .stat-card{
+    background:var(--ink3);border:1px solid var(--line);border-radius:var(--r);
+    padding:26px 24px;transition:border-color .25s,transform .25s;
+  }
+  .stat-card:hover{border-color:var(--line2);transform:translateY(-2px)}
+  .stat-card .lab{font-family:'JetBrains Mono';font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-bottom:10px}
