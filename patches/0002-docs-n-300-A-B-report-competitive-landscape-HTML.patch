+  .two-col section{padding:0;border:none}
+
+  /* legend */
+  .legend{display:flex;gap:20px;margin-top:18px;font-family:'JetBrains Mono';
+    font-size:11px;color:var(--mute);flex-wrap:wrap}
+  .legend span{display:flex;align-items:center;gap:7px}
+  .swatch{width:12px;height:12px;border-radius:3px;display:inline-block}
+
+  /* honest panel */
+  .honest{background:
+      repeating-linear-gradient(135deg,transparent,transparent 9px,rgba(244,164,60,.025) 9px,rgba(244,164,60,.025) 18px),
+      var(--ink2);
+    border:1px solid var(--amber-dim);border-radius:var(--r);padding:30px}
+  .honest h2{font-size:26px;margin-top:12px}
+  .honest ul{margin-top:18px;list-style:none}
+  .honest li{padding:8px 0 8px 26px;position:relative;color:var(--mute);font-size:14px;line-height:1.6}
+  .honest li::before{content:"▸";position:absolute;left:0;color:var(--amber);font-weight:700}
+  .honest li b{color:var(--paper);font-weight:600}
+
+  /* mcnemar table */
+  .mc-table{width:100%;border-collapse:collapse;font-family:'JetBrains Mono';font-size:13px;margin-top:10px}
+  .mc-table th,.mc-table td{padding:14px 10px;text-align:center;border:1px solid var(--line)}
+  .mc-table th{background:var(--ink3);color:var(--mute);font-weight:500}
+  .mc-table .big{font-family:'Space Grotesk';font-size:34px;font-weight:700;color:var(--paper)}
+  .mc-table .lbl{font-size:10px;color:var(--faint);text-transform:uppercase;letter-spacing:.08em}
+  .mc-table .helped .big{color:var(--good)}
+  .mc-table .hurt .big{color:var(--bad)}
+  .mc-stat{font-family:'JetBrains Mono';font-size:12px;color:var(--mute);margin-top:16px}
+  .mc-stat b{color:var(--paper);font-weight:500}
+  .mc-stat .pval{color:var(--bad);font-weight:700}
+
+  footer{padding:38px 0 56px;color:var(--faint);font-family:'JetBrains Mono';font-size:12px}
+  footer b{color:var(--mute);font-weight:500}
+
+  @media(max-width:900px){
+    .stats-grid{grid-template-columns:1fr}
+    .two-col{grid-template-columns:1fr}
+  }
+  @media(max-width:480px){
+    .wrap{padding:0 18px}
+    .brand .tag{display:none}
+  }
+  @media(prefers-reduced-motion:reduce){
+    *{transition:none!important;animation:none!important}
+  }
+</style>
+</head>
+<body>
+
+<header>
+  <div class="wrap">
+    <div class="brand">
+      <span class="logo">smriti</span>
+      <span class="deva">स्मृति</span>
+      <span class="tag">pariksha · a/b report</span>
+    </div>
+    <p class="eyebrow">longmemeval oracle · full mode · deepseek-v4-flash</p>
+    <h1>Observation Stack A/B <br>at <span class="obs">n = 300</span></h1>
+    <p class="lede">Baseline (<b>full</b>) vs. treatment (<b>full + --observations</b>). The observation stack synthesises per-entity summaries, additive enumerations, and numeric digests at ingest time and injects them into the answer context.</p>
+    <div class="facts">
+      <span class="chip"><b>300</b> stratified questions</span>
+      <span class="chip"><b>run</b> ab_20260617_135940</span>
+      <span class="chip"><b>judge</b> nyaya · fixed model</span>
+      <span class="chip"><b>effect</b> +1.0 pp overall · p≈0.77</span>
+    </div>
+  </div>
+</header>
+
+<main>
+  <section>
+    <div class="wrap">
+      <div class="sec-head">
+        <span class="eyebrow">headline</span>
+        <h2>The overall delta is positive, but not significant</h2>
+        <p>With 300 questions the +1.0 percentage-point lift is smaller than the n=200 run (+4.8 pp). The McNemar discordant count (47 pairs) gives z≈0.29, p≈0.77 — we cannot reject the null that observations have no effect on overall accuracy.</p>
+      </div>
+      <div class="stats-grid">
+        <div class="stat-card">
+          <div class="lab">Baseline accuracy</div>
+          <div class="num">67.7<small>%</small></div>
+          <div class="sub">203 / 300 questions correct</div>
+        </div>
+        <div class="stat-card neut">
+          <div class="lab">Treatment accuracy</div>
+          <div class="num">68.7<small>%</small></div>
+          <div class="sub">206 / 300 questions correct</div>
+        </div>
+        <div class="stat-card neut">
+          <div class="lab">Overall delta</div>
+          <div class="num">+1.0<small>pp</small></div>
+          <div class="sub">McNemar p≈0.77 · not significant</div>
+        </div>
+      </div>
+    </div>
+  </section>
+
+  <section>
+    <div class="wrap">
+      <div class="chart-card">
+        <h3 class="chart-title">Accuracy by question type</h3>
+        <p class="chart-sub">Treatment wins on multi-session and temporal reasoning but regresses on knowledge-update and single-session categories. Sample size is 54 per category except preference (30).</p>
+        <svg class="chart-svg" id="acc-chart" viewBox="0 0 860 360" preserveAspectRatio="xMidYMid meet"></svg>
+        <div class="legend">
+          <span><i class="swatch" style="background:var(--faint);border:1px solid var(--line2)"></i> baseline (full)</span>
+          <span><i class="swatch" style="background:var(--amber)"></i> treatment (full + --observations)</span>
+          <span><i class="swatch" style="background:var(--good)"></i> positive delta</span>
+          <span><i class="swatch" style="background:var(--bad)"></i> negative delta</span>
+        </div>
+      </div>
+    </div>
+  </section>
+
+  <section class="two-col">
+    <div class="wrap" style="display:contents">
+      <section>
+        <div class="chart-card">
+          <h3 class="chart-title">McNemar discordance</h3>
+          <p class="chart-sub">Same questions answered twice; only the 47 discordant pairs carry evidence of an effect.</p>
+          <table class="mc-table">
+            <tr>
+              <th></th>
+              <th>Baseline correct</th>
+              <th>Baseline wrong</th>
+            </tr>
+            <tr>
+              <th>Treatment correct</th>
+              <td><div class="big">181</div><div class="lbl">both right</div></td>
+              <td class="helped"><div class="big">25</div><div class="lbl">helped</div></td>
+            </tr>
+            <tr>
+              <th>Treatment wrong</th>
+              <td class="hurt"><div class="big">22</div><div class="lbl">hurt</div></td>
+              <td><div class="big">72</div><div class="lbl">both wrong</div></td>
+            </tr>
+          </table>
+          <div class="mc-stat">
+            discordant = <b>47</b> · z = <b>0.29</b> · two-sided p = <b class="pval">0.77</b>
+          </div>
+        </div>
+      </section>
+      <section>
+        <div class="chart-card">
+          <h3 class="chart-title">Net flips by category</h3>
+          <p class="chart-sub">Number of questions helped minus hurt. Multi-session dominates; knowledge-update is the main concern.</p>
+          <svg class="chart-svg" id="flip-chart" viewBox="0 0 420 340" preserveAspectRatio="xMidYMid meet"></svg>
+        </div>
+      </section>
+    </div>
+  </section>
+
+  <section>
+    <div class="wrap">
+      <div class="chart-card">
+        <h3 class="chart-title">n=200 → n=300: the effect cooled and shifted</h3>
+        <p class="chart-sub">At n=200 the observation stack looked near-significant (+4.8 pp, p≈0.095). Scaling to n=300 shrank the overall lift and revealed a knowledge-update regression that was a small gain at n=200.</p>
+        <svg class="chart-svg" id="evo-chart" viewBox="0 0 860 360" preserveAspectRatio="xMidYMid meet"></svg>
+      </div>
+    </div>
+  </section>
+
+  <section>
+    <div class="wrap">
+      <div class="honest">
+        <span class="eyebrow">interpretation · honest read</span>
+        <h2>What the n=300 run is really saying</h2>
+        <ul>
+          <li><b>The overall story is murky.</b> +1.0 pp is directionally positive, but the McNemar p-value (~0.77) means this difference is easily explained by chance.</li>
+          <li><b>Multi-session is the clear win.</b> +18.5 pp and a net +10 flips suggest observations help the model bridge evidence across sessions.</li>
+          <li><b>Knowledge-update regressed hard.</b> From +2.9 pp at n=200 to −13.0 pp at n=300 (net −7 flips). The extra synthesized context may be distracting the model from the latest superseding fact.</li>
+          <li><b>Temporal-reasoning still gains, but less.</b> Cooled from +17.6 pp to +7.4 pp — real, but not the dramatic effect seen earlier.</li>
+          <li><b>Recommendation:</b> do not ship the stack as-is. Diagnose why observations hurt knowledge-update; consider enabling them only for multi-session / temporal queries, or guard the digest injection so it cannot override explicit supersession.</li>
+        </ul>
+      </div>
+    </div>
+  </section>
+</main>
+
+<footer>
+  <div class="wrap">
+    <b>Data source</b> · bench_results/ab_20260617_135940/{base,treat}.json · LongMemEval oracle split · n=300 stratified questions<br>
+    <b>Reference</b> · n=200 numbers from bench_results/ab_20260617_103701 and BENCHMARKS.md · SMRITI · स्मृति
+  </div>
+</footer>
+
+<script>
+const CATS = [
+  {key:"multi-session", label:"Multi-session", base:20.37, treat:38.89, delta:18.52, net:10, n:54},
+  {key:"temporal-reasoning", label:"Temporal reasoning", base:66.67, treat:74.07, delta:7.40, net:4, n:54},
+  {key:"single-session-user", label:"Single-session user", base:92.59, treat:94.44, delta:1.85, net:1, n:54},
+  {key:"single-session-assistant", label:"Single-session assistant", base:79.63, treat:74.07, delta:-5.56, net:-3, n:54},
+  {key:"single-session-preference", label:"Single-session preference", base:43.33, treat:36.67, delta:-6.67, net:-2, n:30},
+  {key:"knowledge-update", label:"Knowledge update", base:92.59, treat:79.63, delta:-12.96, net:-7, n:54}
+];
+
+const N200 = {
+  "multi-session":6.6,
+  "temporal-reasoning":17.6,
+  "single-session-user":0.0,
+  "single-session-assistant":5.9,
+  "single-session-preference":-6.7,
+  "knowledge-update":2.9
+};
+
+const colors = {
+  base:'#5C667E',
+  treat:'#F4A43C',
+  good:'#52C7BE',
+  bad:'#E08AA0',
+  grid:'#27314A',
+  text:'#E8ECF5',
+  mute:'#8A93AB'
+};
+
+function svgEl(tag, attrs={}){
+  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
+  for(const [k,v] of Object.entries(attrs)) el.setAttribute(k, v);
+  return el;
+}
+
+function makeAccChart(){
+  const svg = document.getElementById('acc-chart');
+  const W=860, H=360, L=170, R=30, T=20, B=40;
+  const plotW = W-L-R, plotH = H-T-B;
+  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
+
+  // grid lines
+  for(let pct=0; pct<=100; pct+=20){
+    const x = L + (pct/100)*plotW;
+    svg.appendChild(svgEl('line',{x1:x,y1:T,x2:x,y2:H-B,stroke:colors.grid,'stroke-width':1}));
+    svg.appendChild(svgEl('text',{x:x,y:H-B+22,'text-anchor':'middle',fill:colors.mute,'font-size':'11','font-family':'JetBrains Mono'})).textContent = pct+'%';
+  }
+
+  const rowH = plotH / CATS.length;
+  const barH = rowH * 0.28;
+  const gap = 4;
+
+  CATS.forEach((c,i)=>{
+    const y = T + i*rowH + (rowH - (2*barH+gap))/2;
+    const xBase = L + (c.base/100)*plotW;
+    const xTreat = L + (c.treat/100)*plotW;
+
+    // label
+    svg.appendChild(svgEl('text',{x:L-14,y:y+barH+gap/2+3,'text-anchor':'end',fill:colors.text,'font-size':'12','font-weight':'500'})).textContent = c.label;
+    svg.appendChild(svgEl('text',{x:L-14,y:y+barH+gap/2+18,'text-anchor':'end',fill:colors.mute,'font-size':'9','font-family':'JetBrains Mono'})).textContent = `n=${c.n}`;
+
+    // baseline bar
+    svg.appendChild(svgEl('rect',{x:L,y:y,width:xBase-L,height:barH,rx:3,fill:colors.base,opacity:0.45,stroke:colors.base,'stroke-width':1}));
+    // treatment bar
+    svg.appendChild(svgEl('rect',{x:L,y:y+barH+gap,width:xTreat-L,height:barH,rx:3,fill:colors.treat}));
+
+    // baseline value
+    svg.appendChild(svgEl('text',{x:xBase+6,y:y+barH/2+4,fill:colors.mute,'font-size':'11','font-family':'JetBrains Mono'})).textContent = c.base.toFixed(1)+'%';
+    // treatment value
+    svg.appendChild(svgEl('text',{x:xTreat+6,y:y+barH+gap+barH/2+4,fill:colors.treat,'font-size':'11','font-family':'JetBrains Mono','font-weight':'600'})).textContent = c.treat.toFixed(1)+'%';
+
+    // delta annotation
+    const deltaColor = c.delta >= 0 ? colors.good : colors.bad;
+    const xEnd = Math.max(xBase, xTreat);
+    const deltaX = xEnd + 56;
+    const deltaY = y + barH + gap/2 + 4;
+    const sign = c.delta > 0 ? '+' : '';
+    svg.appendChild(svgEl('text',{x:deltaX,y:deltaY,fill:deltaColor,'font-size':'12','font-family':'JetBrains Mono','font-weight':'700'})).textContent = sign+c.delta.toFixed(1)+' pp';
+  });
+}
+
+function makeFlipChart(){
+  const svg = document.getElementById('flip-chart');
+  const W=420, H=340, L=160, R=50, T=20, B=30;
+  const plotW = W-L-R, plotH = H-T-B;
+  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
+
+  const maxNet = Math.max(...CATS.map(c=>Math.abs(c.net)));
+  const scale = plotW / (2 * (maxNet + 1));
+  const zero = L + (maxNet+1)*scale;
+
+  // zero line
+  svg.appendChild(svgEl('line',{x1:zero,y1:T,x2:zero,y2:H-B,stroke:colors.text,'stroke-width':2}));
+  // grid
+  for(let v=-8; v<=10; v+=2){
+    if(v===0) continue;
+    const x = zero + v*scale;
+    if(x < L || x > W-R) continue;
+    svg.appendChild(svgEl('line',{x1:x,y1:T,x2:x,y2:H-B,stroke:colors.grid,'stroke-width':1,'stroke-dasharray':'3 3'}));
+    svg.appendChild(svgEl('text',{x:x,y:H-B+18,'text-anchor':'middle',fill:colors.mute,'font-size':'9','font-family':'JetBrains Mono'})).textContent = (v>0?'+':'')+v;
+  }
+
+  const rowH = plotH / CATS.length;
+  const barH = rowH * 0.5;
+
+  CATS.forEach((c,i)=>{
+    const y = T + i*rowH + (rowH-barH)/2;
+    const x = zero;
+    const w = c.net * scale;
+    const color = c.net >= 0 ? colors.good : colors.bad;
+    svg.appendChild(svgEl('rect',{x:Math.min(x,x+w),y:y,width:Math.abs(w),height:barH,rx:4,fill:color,opacity:0.85}));
+    svg.appendChild(svgEl('text',{x:L-10,y:y+barH/2+4,'text-anchor':'end',fill:colors.text,'font-size':'11','font-weight':'500'})).textContent = c.label;
+    const tx = c.net >= 0 ? x+w+8 : x+w-8;
+    svg.appendChild(svgEl('text',{x:tx,y:y+barH/2+4,'text-anchor':c.net>=0?'start':'end',fill:color,'font-size':'12','font-family':'JetBrains Mono','font-weight':'700'})).textContent = (c.net>0?'+':'')+c.net;
+  });
+}
+
+function makeEvoChart(){
+  const svg = document.getElementById('evo-chart');
+  const W=860, H=360, L=180, R=40, T=30, B=40;
+  const plotW = W-L-R, plotH = H-T-B;
+  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
+
+  // y axis centered at 0
+  const maxAbs = 20;
+  const yScale = plotH / (2 * maxAbs);
+  const zeroY = T + maxAbs * yScale;
+
+  // x positions
+  const x200 = L + plotW * 0.3;
+  const x300 = L + plotW * 0.7;
+
+  // grid
+  for(let v=-20; v<=20; v+=10){
+    const y = zeroY - v*yScale;
+    svg.appendChild(svgEl('line',{x1:L,y1:y,x2:W-R,y2:y,stroke:colors.grid,'stroke-width':1}));
+    svg.appendChild(svgEl('text',{x:L-10,y:y+4,'text-anchor':'end',fill:colors.mute,'font-size':'10','font-family':'JetBrains Mono'})).textContent = (v>0?'+':'')+v+' pp';
+  }
+
+  // x axis labels
+  svg.appendChild(svgEl('text',{x:x200,y:H-10,'text-anchor':'middle',fill:colors.text,'font-size':'13','font-weight':'600','font-family':'Space Grotesk'})).textContent = 'n = 200';
+  svg.appendChild(svgEl('text',{x:x300,y:H-10,'text-anchor':'middle',fill:colors.text,'font-size':'13','font-weight':'600','font-family':'Space Grotesk'})).textContent = 'n = 300';
+
+  const rowStep = plotH / CATS.length;
+
+  CATS.forEach((c,i)=>{
+    const y = T + i*rowStep + rowStep/2;
+    const d200 = N200[c.key];
+    const d300 = c.delta;
+    const y200 = zeroY - d200*yScale;
+    const y300 = zeroY - d300*yScale;
+    const color = d300 >= 0 ? colors.good : colors.bad;
+
+    // category label
+    svg.appendChild(svgEl('text',{x:L-16,y:y+4,'text-anchor':'end',fill:colors.text,'font-size':'11','font-weight':'500'})).textContent = c.label;
+
+    // slope line
+    svg.appendChild(svgEl('line',{x1:x200,y1:y200,x2:x300,y2:y300,stroke:color,'stroke-width':2,opacity:0.6}));
+
+    // dots
+    svg.appendChild(svgEl('circle',{cx:x200,cy:y200,r:5,fill:colors.mute}));
+    svg.appendChild(svgEl('circle',{cx:x300,cy:y300,r:6,fill:color}));
+
+    // value labels
+    svg.appendChild(svgEl('text',{x:x200,y:y200-10,'text-anchor':'middle',fill:colors.mute,'font-size':'9','font-family':'JetBrains Mono'})).textContent = (d200>0?'+':'')+d200.toFixed(1);
+    svg.appendChild(svgEl('text',{x:x300,y:y300-12,'text-anchor':'middle',fill:color,'font-size':'10','font-family':'JetBrains Mono','font-weight':'700'})).textContent = (d300>0?'+':'')+d300.toFixed(1);
+  });
+}
+
+// Animate chart entrance
+function revealOnScroll(id, fn){
+  const el = document.getElementById(id);
+  let done=false;
+  const io = new IntersectionObserver(entries=>{
+    entries.forEach(e=>{
+      if(e.isIntersecting && !done){ done=true; el.innerHTML=''; fn(); io.disconnect(); }
+    });
+  },{threshold:0.25});
+  io.observe(el.parentElement);
+}
+
+revealOnScroll('acc-chart', makeAccChart);
+revealOnScroll('flip-chart', makeFlipChart);
+revealOnScroll('evo-chart', makeEvoChart);
+</script>
