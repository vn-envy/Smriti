+      setTimeout(()=>rect.setAttribute('width',x-L), 100+ci*60+si*30);
+      // value at end
+      const tx=svgEl('text',{x:x+4,y:y+barH-1,fill:s.color,'font-size':'9','font-family':'JetBrains Mono','font-weight':s.dashed?'700':'500',opacity:0});
+      tx.textContent=v; svg.appendChild(tx);
+      setTimeout(()=>tx.setAttribute('opacity',1),500+ci*60+si*30);
+    });
+  });
+  const lg=document.getElementById('bars-legend');
+  SYSTEMS.forEach(s=>{
+    const sp=document.createElement('span');
+    sp.innerHTML=`<i class="swatch ${s.dashed?'dashed':''}" style="background:${s.dashed?'transparent':s.color};${s.dashed?'border:2px dashed '+s.color:''}"></i> ${s.name}`;
+    lg.appendChild(sp);
+  });
+}
+
+// ── LOCOMO ─────────────────────────────────────────────
+function makeLocomo(){
+  const svg=document.getElementById('locomo');
+  const W=440,H=360,L=40,R=40,T=30,B=60;
+  const plotW=W-L-R, plotH=H-T-B;
+  const data=[
+    {name:"mem0",v:92.5,c:"#52C7BE",m:"J"},
+    {name:"Human",v:87.9,c:"#6ba3d6",m:"F1"},
+    {name:"Zep",v:75.14,c:"#E08AA0",m:"J"},
+    {name:"Full-context",v:72.9,c:"#8A93AB",m:"J"},
+    {name:"Supermemory",v:null,c:"#b794e0",m:"—"},
+    {name:"SMRITI",v:null,c:"#F4A43C",m:"—"}
+  ];
+  const bw=plotW/data.length*0.6;
+  const step=plotW/data.length;
+  // y grid
+  for(let p=0;p<=100;p+=20){
+    const y=H-B-(p/100)*plotH;
+    svg.appendChild(svgEl('line',{x1:L,y1:y,x2:W-R,y2:y,stroke:'#27314A','stroke-width':1}));
+    svg.appendChild(svgEl('text',{x:L-8,y:y+4,'text-anchor':'end',fill:'#8A93AB','font-size':'9','font-family':'JetBrains Mono'})).textContent=p;
+  }
+  // separator between J (first 4) and F1 — actually mixed; draw metric tag on each
+  data.forEach((d,i)=>{
+    const x=L+i*step+step/2-bw/2;
+    if(d.v==null){
+      // placeholder hatched
+      const y=H-B-plotH*0.08;
+      const r=svgEl('rect',{x:x,y:H-B-plotH,width:bw,height:plotH*0.08,rx:2,fill:'repeating-linear-gradient(45deg,#27314A,#27314A 3px,transparent 3px,transparent 6px)'});
+      // svg doesn't do css gradient in fill attr; emulate with a pattern instead
+      svg.appendChild(r);
+      r.setAttribute('fill','url(#hatch)');
+      svg.appendChild(svgEl('text',{x:x+bw/2,y:H-B-plotH*0.08-6,'text-anchor':'middle',fill:'#5C667E','font-size':'9','font-family':'JetBrains Mono'})).textContent='n/a';
+    } else {
+      const h=(d.v/100)*plotH;
+      const y=H-B-h;
+      const rect=svgEl('rect',{x:x,y:H-B,width:bw,height:0,rx:3,fill:d.c,opacity:0.9});
+      svg.appendChild(rect);
+      setTimeout(()=>rect.setAttribute('height',h),200+i*120);
+      setTimeout(()=>{rect.setAttribute('y',y);},200+i*120);
+      svg.appendChild(svgEl('text',{x:x+bw/2,y:y-8,'text-anchor':'middle',fill:d.c,'font-size':'11','font-family':'JetBrains Mono','font-weight':'700'})).textContent=d.v;
+    }
+    // x label
+    svg.appendChild(svgEl('text',{x:x+bw/2,y:H-B+16,'text-anchor':'middle',fill:'#E8ECF5','font-size':'10','font-weight':'500'})).textContent=d.name;
+    svg.appendChild(svgEl('text',{x:x+bw/2,y:H-B+30,'text-anchor':'middle',fill:'#5C667E','font-size':'9','font-family':'JetBrains Mono'})).textContent=d.m;
+  });
+  // hatch pattern
+  const defs=svgEl('defs');
+  const pat=svgEl('pattern',{id:'hatch',width:6,height:6,patternTransform:'rotate(45)',patternUnits:'userSpaceOnUse'});
+  pat.appendChild(svgEl('rect',{width:6,height:6,fill:'#1B2438'}));
+  pat.appendChild(svgEl('line',{x1:0,y1:0,x2:0,y2:6,stroke:'#5C667E','stroke-width':2}));
+  defs.appendChild(pat);
+  svg.insertBefore(defs, svg.firstChild);
+  // metric note
+  svg.appendChild(svgEl('text',{x:W/2,y:H-8,'text-anchor':'middle',fill:'#5C667E','font-size':'9','font-family':'JetBrains Mono'})).textContent='J = vendor LLM-judge · F1 = paper metric (not comparable)';
+}
+
+// ── GAP TABLE ──────────────────────────────────────────
+function makeTable(){
+  const t=document.getElementById('gap-table');
+  const leader=CATS.map((c,i)=>Math.max(SYSTEMS[0].per[KEYS[i]],SYSTEMS[1].per[KEYS[i]])); // Supermemory or mem0
+  let head='<tr><th style="text-align:left">Category</th><th>Supermemory</th><th>mem0</th><th>Zep</th><th>Full-ctx</th><th class="smr" style="color:var(--amber)">SMRITI*</th><th>Leader</th><th>Δ to leader</th></tr>';
+  let rows='';
+  CATS.forEach((c,i)=>{
+    const vals=SYSTEMS.map(s=>s.per[KEYS[i]]);
+    const ld=leader[i];
+    const smr=SYSTEMS[4].per[KEYS[i]];
+    const delta=smr-ld;
+    rows+=`<tr><td class="nm">${SHORT[c]}</td>`+
+      vals.map((v,j)=>`<td class="${j===4?'smr':''}">${v}</td>`).join('')+
+      `<td class="win">${ld}</td>`+
+      `<td class="${delta<0?'gap':'win'}">${delta>0?'+':''}${delta.toFixed(1)}</td></tr>`;
+  });
+  // overall row
+  const ov=SYSTEMS.map(s=>s.overall);
+  const ldO=Math.max(...ov.slice(0,2));
+  rows+=`<tr><td class="nm" style="font-weight:700">Overall</td>`+
+    ov.map((v,j)=>`<td class="${j===4?'smr':''}" style="font-weight:700">${v}</td>`).join('')+
+    `<td class="win" style="font-weight:700">${ldO}</td>`+
+    `<td class="gap" style="font-weight:700">${(SYSTEMS[4].overall-ldO).toFixed(1)}</td></tr>`;
+  t.innerHTML=head+rows;
+}
+
+// reveal on scroll
+function reveal(id, fn){
+  const el=document.getElementById(id);
+  let done=false;
+  const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting&&!done){done=true;fn();io.disconnect();}})},{threshold:.2});
+  io.observe(el.parentElement);
+}
+reveal('radar',makeRadar);
+reveal('bars',makeBars);
+reveal('locomo',makeLocomo);
+makeTable();
+</script>
+</body>
+</html>
