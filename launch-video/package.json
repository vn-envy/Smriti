{
  "name": "smriti-launch",
  "version": "1.0.0",
  "private": true,
  "description": "SMRITI launch film \u2014 Remotion + three.js + Paper Shaders",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs",
    "dev": "remotion studio",
    "render": "remotion render SmritiLaunch out/smriti-launch.mp4",
    "render:teaser": "remotion render SmritiLaunch30 out/smriti-launch-teaser-30s.mp4 --codec=h264 --crf=18",
    "bundle:webgpu": "esbuild webgpu/preview.ts --bundle --format=esm --outfile=public/webgpu-preview.js",
    "still": "remotion still SmritiLaunch",
    "typecheck": "tsc --noEmit",
    "render:social": "remotion render SmritiSocial60 out/smriti-social-launch-60s.mp4 --codec=h264 --crf=18 && python3 scripts/finalize-social.py",
    "stills:social": "node scripts/social-stills.mjs",
    "audio:social": "python3 scripts/prepare-social-audio.py",
    "render:camera": "remotion render SmritiSocialCamera60 out/smriti-social-launch-60s-camera.mp4 --codec=h264 --crf=18 && python3 scripts/finalize-social.py --camera",
    "stills:camera": "node scripts/social-stills.mjs --camera"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.20",
    "@fontsource/jetbrains-mono": "^5.0.20",
    "@fontsource/noto-sans-devanagari": "^5.0.20",
    "@fontsource/space-grotesk": "^5.0.20",
    "@paper-design/shaders-react": "0.0.53",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "4.0.481",
    "@remotion/fonts": "4.0.481",
    "@remotion/media": "4.0.481",
    "@remotion/three": "4.0.481",
    "@remotion/transitions": "4.0.481",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.481",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/three": "^0.166.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  }
}
